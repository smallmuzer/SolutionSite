            },
            computed: {
                filteredItems: function () {
                    var searchText = this.SearchText;
                    if(!searchText || searchText.length <= 2)
                        return [];

                    return this.Menus.filter(function (x) {
                        return compareObj(x.MenuName, searchText)
                            || compareObj(x.Url, searchText)
                            || compareObj(x.Tags, searchText)
                            || x.MenuItems.some(y => compareObj(y.MenuName, searchText) || compareObj(y.Url, searchText) || compareObj(y.Tags, searchText)
                                || y.MenuItems.some(z => compareObj(z.MenuName, searchText) || compareObj(z.Url, searchText) || compareObj(z.Tags, searchText)))
                    });
                }
            },
            methods:{
                getMenus: function (menus) {
                    var searchText = this.SearchText;

                    return menus.filter(function (x) {
                        return compareObj(x.MenuName, searchText)
                            || compareObj(x.Url, searchText)
                            || compareObj(x.Tags, searchText)
                            || x.MenuItems.some(y => compareObj(y.MenuName, searchText) || compareObj(y.Url, searchText) || compareObj(y.Tags, searchText))
                    });
                }
            }
        })
    </script>
