            methods: {
                load: function () {
                    $.getData("/Admin/ReadReportHeaders", null, function (res) {
                        app.Items = res;
                    });
                },
                getTime: function () {
                    return new Date().getTime()
                },
                selectItem: function (id) {
                    this.Item = this.Items.filter(x => x.ID == id)[0];
                },
                uploadHeader: function (id) {
                    this.selectItem(id);
                    this.Option = "UPDATE_REPORT_HEADER";
                    $('#ImageFile').click();
                },
                uploadFooter: function (id) {
                    this.selectItem(id);
                    this.Option = "UPDATE_REPORT_FOOTER";
                    $('#ImageFile').click();
                },
                uploadLogo: function (id) {
                    this.selectItem(id);
                    this.Option = "UPDATE_LOGO";
                    $('#ImageFile').click();
                },
                uploadStamp: function (id) {
                    this.selectItem(id);
                    this.Option = "UPDATE_STAMP";
                    $('#ImageFile').click();
                },
                deleteHeader: function (id) {
                    this.selectItem(id);
                    kendoConfirm("Do you want to Remove this Image?", function () {
                        $.getData("/Admin/RemoveReportHeader", { Option: "REMOVE_REPORT_HEADER", ID: id, ExistingImage: app.Item.ReportHeaderImage }, app.onSuccess);
                    });
                },
                deleteFooter: function (id) {
                    this.selectItem(id);
                    kendoConfirm("Do you want to Remove this Image?", function () {
                        $.getData("/Admin/RemoveReportHeader", { Option: "REMOVE_REPORT_FOOTER", ID: id, ExistingImage: app.Item.ReportFooterImage }, app.onSuccess);
                    });
                },
                deleteLogo: function (id) {
                    this.selectItem(id);
                    kendoConfirm("Do you want to Remove this Image?", function () {
                        $.getData("/Admin/RemoveReportHeader", { Option: "REMOVE_LOGO", ID: id, ExistingImage: app.Item.LogoImage }, app.onSuccess);
                    });
                },
                deleteStamp: function (id) {
                    this.selectItem(id);
                    kendoConfirm("Do you want to Remove this Image?", function () {
                        $.getData("/Admin/RemoveReportHeader", { Option: "REMOVE_STAMP", ID: id, ExistingImage: app.Item.LogoImage }, app.onSuccess);
                    });
                },
                reportHeaderFooterChecked: function (id) {
                    this.selectItem(id);
                    if ($('#reportcheckbox_'+id).prop("checked")) {
                         kendoConfirm("Do you want to enable this Image?", function () {
                             $.getData("/Admin/CheckReportImage", { Option: "UPDATE_ISREPORTHEADERIMAGE", ID: id, Message: "Selected Image Saved." }, app.onSuccess);
                    });
                    }
                    else {
                         kendoConfirm("Do you want to disable this Image?", function () {
                             $.getData("/Admin/CheckReportImage", { Option: "REMOVE_ISREPORTHEADERIMAGE", ID: id, Message: "Selected Image Removed."}, app.onSuccess);
                    });
                    }
                },
                onSuccess: function (res) {
                    kendoAlert(res.Message, res.HasError);
                    if (res.HasError)
                        return;
                    this.load();
                }
            }
        });

        function ImageFile_Upload(e) {
            var img = "", imageName;
            if (app.Option == "UPDATE_REPORT_HEADER") {
                img = app.Item.ReportHeaderImage;
                imageName = "ReportHeader";
            }
            else if (app.Option == "UPDATE_REPORT_FOOTER") {
                img = app.Item.ReportFooterImage;
                imageName = "ReportFooter";
            }
            else if (app.Option == "UPDATE_LOGO") {
                img = app.Item.LogoImage;
                imageName = "LogoImage";
            }
            else {
                img = app.Item.StampImage;
                imageName = "StampImage";
            }

            e.data = {
                Option: app.Option,
                ID: app.Item.ID,
                ExistingImage: img,
                ImageName: imageName
            };
        }

        function ImageFile_Success(e) {
            app.onSuccess(e.response);
        }
    </script>


            <script>
	kendo.syncReady(function(){jQuery("#wndDivision").kendoWindow({"modal":true,"iframe":false,"draggable":false,"scrollable":true,"pinned":false,"title":"Switch Entity","resizable":false,"actions":["Close"]});});
</script>


            <script type="text/javascript">

                function switchEntity() {
                    $('#ddMainEntity').getKendoComboBox().value("");
                    $('#wndDivision').getKendoWindow().open();
                    $('#wndDivision').getKendoWindow().center();
                    setTimeout(function () {
                        $('#ddMainEntity').getKendoComboBox().focus();
                    }, 500);
                }

                function ddMainEntity_Change() {
                    if (this.selectedIndex == -1)
                        return;
                    $.post('/Admin/SwitchEntity', { ID: this.value() }, function (data) {
                        if (data.HasError) {
                            kendoAlert(data.Message, true);
                            return;
                        }
                        localStorage.setItem("NotificationCount", "NONE");
                        var hasQueryString = false;
                        if (hasQueryString)
                            location.href = "/Announcement/Announcement";
                        else
                            location.reload();
                    });
                }

            </script>
        <script>
	kendo.syncReady(function(){jQuery("#EmployeePopUpWindow").kendoWindow({"iframe":false,"draggable":false,"scrollable":true,"pinned":false,"title":"Employee List","resizable":false,"actions":["Close"]});});
</script>

    <script type="text/javascript">
        $(function () {
            $("#EmployeePopUpWindow").on("click", ".k-grid-content tr", function () {
                var dataItem = $("#gdEmployeeList").getKendoGrid().dataItem($(this));
                var btnID = $('#gdEmployeeList').attr("data-sender");
                var $ddEmp = $('#' + btnID).parent().prev().find('[data-role=combobox]').getKendoComboBox();
                $ddEmp.value(dataItem.ID);
                $ddEmp.trigger("change");
                $('#EmployeePopUpWindow').getKendoWindow().close();
            });

        });

        function OpenEmpWnd(btnID) {
            btnID = btnID ? btnID : 'btnSearch';
            $('#EmployeePopUpWindow').getKendoWindow().open();
            $('#gdEmployeeList').attr("data-sender", btnID).getKendoGrid().dataSource.data($('#' + btnID).parent().prev().find('[data-role=combobox]').getKendoComboBox().dataSource.data());
            $('#EmployeePopUpWindow').getKendoWindow().center();
        }
    </script>

    <script type="text/javascript">
        $(function () {
            if (localStorage.getItem("NotificationCount") == 'NONE') {
               lapp.resetCount()
            }
            else {
                lapp.setNCount();
            }
        });
        //var lappchat = new Vue({
        //    el: '#lappchat',
        //    data: {
        //        IsAskHR: appChat.IsAppChat
        //    }
        //});
        var lapp = new Vue({
            el: '#lapp',
            data: {
                input: {"NotificationType":null,"EmpID":null,"FullName":null,"Details":null,"EventDate":new Date(1,0,1,0,0,0,0),"WebLink":null,"MobileLink":null,"AccessMode":0,"Icon":null,"Color":null},
                NotificationList: [],
                AccessMode: -1
            },
            computed: {
                filteredItems: function() {
                    var accessMode = this.AccessMode;
                    return $.grep(this.NotificationList, function(x) {
                        return accessMode == -1 || x.AccessMode == accessMode
                        });
                }
            },
            methods: {
                weburl: function (url) {
                    window.location.href = url;
                },
                showNotification: function (e) {
                    if (e == 1)
                        $('#ddNotify').dropdown('toggle');
                     var self = this;
                    $.postData('/General/ReadPendingNotifications', null, function (res) {
                        self.NotificationList = res.Data;
                    });
                },
                filter: function (e) {
                    this.AccessMode = e;
                },
                setNCount: function () {
                    var cnt = localStorage.getItem("NotificationCount");
                    $("#nCnt").text(cnt);
                    if (cnt == 0)
                        $("#nCnt").hide();
                    else
                        $("#nCnt").show();
                },
                resetCount: function (e) {
                     $.postData('/General/GetNotificationCount', null, function (res) {
                        var returnedData = $.grep(res, function (item, index) {
                            return item.NotificationType == "Notifications";
                        });
                        localStorage.setItem("NotificationCount", returnedData[0].Count);
                        lapp.setNCount();
                    });
                }
            }
        });
    </script>

